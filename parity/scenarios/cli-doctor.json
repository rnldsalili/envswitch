{
  "id": "cli-doctor",
  "kind": "cli",
  "argv": [
    "doctor",
    "--vault",
    "alpha",
    "--config-item",
    "cfg"
  ],
  "config": {
    "project": {
      "id": "demo-suite"
    },
    "clients": [
      "alpha",
      "beta"
    ],
    "environments": [
      "local",
      "dev"
    ],
    "targets": [
      {
        "name": "api",
        "output": "apps/api/.env",
        "groups": [
          "apis"
        ]
      },
      {
        "name": "web",
        "output": "apps/web/.env",
        "groups": [
          "apps"
        ]
      }
    ],
    "tags": {
      "base": [
        "envswitch"
      ]
    }
  },
  "files": [
    {
      "path": "apps/api",
      "type": "dir"
    }
  ]
}
