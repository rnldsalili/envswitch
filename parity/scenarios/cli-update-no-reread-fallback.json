{
  "id": "cli-update-no-reread-fallback",
  "kind": "cli",
  "argv": [
    "update",
    "ignored"
  ],
  "files": [
    {
      "path": "{APP}/scripts/{INSTALLER}",
      "content": "fixture only; never executed"
    }
  ],
  "update": {
    "latest": "v0.0.5"
  },
  "divergence": [
    "e1",
    "e2",
    "e3",
    "e5"
  ],
  "rustUpdate": {
    "repo": "demo-suite/alpha",
    "installDir": "{TMP}/launcher",
    "disposition": "installed"
  }
}
