{
  "id": "cli-guided-skip-shape-error",
  "kind": "cli",
  "config": {
    "project": {
      "id": "demo-suite"
    },
    "clients": [
      "alpha",
      "beta"
    ],
    "environments": [
      "local",
      "dev"
    ],
    "targets": [
      {
        "name": "api",
        "output": "apps/api/.env",
        "groups": [
          "apis"
        ]
      },
      {
        "name": "web",
        "output": "apps/web/.env",
        "groups": [
          "apps"
        ]
      }
    ],
    "tags": {
      "base": [
        "envswitch"
      ]
    }
  },
  "argv": [],
  "op": {
    "vaults": [
      {
        "id": "alpha",
        "name": "alpha vault"
      },
      {
        "id": "beta",
        "name": "beta vault"
      }
    ],
    "responses": [
      {
        "argv": [
          "item",
          "list",
          "--vault",
          "beta",
          "--format",
          "json",
          "--tags",
          "envswitch-config"
        ],
        "stdout": "{}",
        "stderr": "",
        "exitCode": 0
      }
    ]
  },
  "prompts": [
    "alpha",
    "local",
    "all",
    true
  ]
}
