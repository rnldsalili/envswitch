{
  "id": "cli-guided-dry",
  "kind": "cli",
  "config": {
    "project": {
      "id": "demo-suite"
    },
    "clients": [
      "alpha",
      "beta"
    ],
    "environments": [
      "local",
      "dev"
    ],
    "targets": [
      {
        "name": "api",
        "output": "apps/api/.env",
        "groups": [
          "apis"
        ]
      },
      {
        "name": "web",
        "output": "apps/web/.env",
        "groups": [
          "apps"
        ]
      }
    ],
    "tags": {
      "base": [
        "envswitch"
      ]
    }
  },
  "argv": [],
  "prompts": [
    "alpha",
    "local",
    "all",
    true
  ]
}
