{
  "id": "cli-update-installer-sigterm",
  "kind": "cli",
  "argv": [
    "update"
  ],
  "files": [
    {
      "path": "{APP}/scripts/{INSTALLER}",
      "content": "fixture only; never executed"
    },
    {
      "path": "{APP}/.version",
      "content": "v0.0.4\n"
    }
  ],
  "update": {
    "exitCode": 143
  },
  "platforms": [
    "macos",
    "linux"
  ],
  "divergence": [
    "e1",
    "e2",
    "e3",
    "e5",
    "e6"
  ],
  "rustUpdate": {
    "repo": "demo-suite/alpha",
    "installDir": "{TMP}/launcher",
    "disposition": "installed"
  }
}
