{
  "id": "cli-flag-target-bare",
  "kind": "cli",
  "argv": [
    "switch",
    "--vault",
    "alpha",
    "--config-item",
    "cfg",
    "--client",
    "alpha",
    "--target"
  ],
  "config": {
    "project": {
      "id": "demo-suite"
    },
    "clients": [
      "alpha",
      "beta"
    ],
    "environments": [
      "local",
      "dev"
    ],
    "targets": [
      {
        "name": "api",
        "output": "apps/api/.env",
        "groups": [
          "apis"
        ]
      },
      {
        "name": "web",
        "output": "apps/web/.env",
        "groups": [
          "apps"
        ]
      }
    ],
    "tags": {
      "base": [
        "envswitch"
      ]
    }
  }
}
